{
  "version": "2.1",
  "envId": "sichuantripmama-d8furc3w318e17b0",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "moments-v2",
      "type": "Event",
      "dir": "./functions/moments-v2",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": false
    },
    {
      "name": "moments-media-upload",
      "type": "HTTP",
      "dir": "./functions/moments-media-upload",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 600,
      "memorySize": 512,
      "installDependency": false,
      "envVariables": {
        "NODE_ENV": "production",
        "CLOUDBASE_ENV_ID": "sichuantripmama-d8furc3w318e17b0",
        "MOMENTS_PUBLIC_URL": "https://sichuantripmama-d8furc3w318e17b0-1491690992.ap-shanghai.app.tcloudbase.com"
      }
    }
  ],
  "hosting": [
    {
      "name": "moments-v2",
      "root": "./static",
      "framework": "static",
      "outputDir": ".",
      "deployPath": "/"
    }
  ],
  "gateway": {
    "routes": [
      { "path": "/api", "target": "function:moments-v2", "enablePathTransmission": true },
      { "path": "/media-upload", "target": "function:moments-media-upload", "enablePathTransmission": true },
      { "path": "/", "target": "hosting:moments-v2" }
    ]
  }
}
